    "%lld notes are not yet searchable. Save or repair them to include their content.": {
      "comment": "App-owned UI. Non-English text is a machine draft pending qualified human review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld note is not yet searchable. Save or repair it to include its content."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld notes are not yet searchable. Save or repair them to include their content."
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld note kan endnu ikke søges. Gem eller reparer den for at medtage indholdet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld noter kan endnu ikke søges. Gem eller reparer dem for at medtage indholdet."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Aún no se puede buscar en %lld nota. Guárdala o repárala para incluir su contenido."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Aún no se puede buscar en %lld notas. Guárdalas o repáralas para incluir su contenido."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld note ne peut pas encore être recherchée. Enregistrez-la ou réparez-la pour inclure son contenu."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld notes ne peuvent pas encore être recherchées. Enregistrez-les ou réparez-les pour inclure leur contenu."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld Notiz ist noch nicht durchsuchbar. Speichern oder reparieren Sie sie, um ihren Inhalt einzubeziehen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "%lld Notizen sind noch nicht durchsuchbar. Speichern oder reparieren Sie sie, um ihren Inhalt einzubeziehen."
                }
              }
            }
          }
        }
      }
    },
