    "Removing models does not remove notes, drawings, transcripts or recordings. Installed functions can run offline when this device and language support them.": {
      "extractionState": "manual",
      "comment": "App-owned UI. Non-English translations are machine drafts; qualified human review pending.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing models does not remove notes, drawings, transcripts or recordings. Installed functions can run offline when this device and language support them."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fjernelse af modeller fjerner ikke noter, tegninger, transskriptioner eller optagelser. Installerede funktioner kan bruges offline, når enheden og sproget understøtter dem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eliminar modelos no elimina notas, dibujos, transcripciones ni grabaciones. Las funciones instaladas pueden funcionar sin conexión si el dispositivo y el idioma las admiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La suppression des modèles ne supprime ni notes, ni dessins, ni transcriptions, ni enregistrements. Les fonctions installées peuvent fonctionner hors ligne si l’appareil et la langue les prennent en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Entfernen von Modellen entfernt keine Notizen, Zeichnungen, Transkripte oder Aufnahmen. Installierte Funktionen können offline arbeiten, wenn Gerät und Sprache sie unterstützen."
          }
        }
      }
