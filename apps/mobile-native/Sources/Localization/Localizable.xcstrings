      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and select desktop notes to add to this cloud library. Original IDs and full stored transcripts are retained. Imported legacy notes are read-only."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gennemgå og vælg skrivebordsnoter, der skal føjes til dette skybibliotek. Oprindelige id’er og hele de gemte transskriptioner bevares. Importerede ældre noter er skrivebeskyttede."
          }
        },
        "es": {
          "stringUnit": {
