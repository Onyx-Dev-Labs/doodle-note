    "%@: cached events may be out of date. Check Calendar settings.": {
      "extractionState": "manual",
      "comment": "App-owned UI. Non-English translations are machine drafts; qualified human review pending.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: cached events may be out of date. Check Calendar settings."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: gemte begivenheder kan være forældede. Kontrollér kalenderindstillinger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: los eventos guardados pueden estar desactualizados. Revisa los ajustes del calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ : les événements en cache peuvent être obsolètes. Vérifiez les réglages du calendrier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: Gespeicherte Termine sind möglicherweise veraltet. Prüfe die Kalendereinstellungen."
          }
        }
      }
    },
